     "FluxTransformer2DModel": extract_flux_context,
     "SenseNovaU1ForCausalLM": extract_sensenova_u1_context,
+    "MiniMaxH3DiTModel": extract_minimax_h3_context,
     # Future models:
     # "CogVideoXTransformer3DModel": extract_cogvideox_context,
 }
