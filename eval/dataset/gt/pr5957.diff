+    def forward(self, inputs: torch.Tensor) -> torch.Tensor:
+        hidden = self.embed(inputs)
+        hidden = self.norm(hidden.transpose(1, 2)).transpose(1, 2)
+        for block in self.convnext:
+            hidden = block(hidden)
+        return self.final_layer_norm(hidden.transpose(1, 2))
