+    def forward(self, inputs: torch.Tensor) -> torch.Tensor:
+        residual = inputs
+        hidden = self.dwconv(inputs).transpose(1, 2)
+        hidden = self.norm(hidden)
+        hidden = self.pwconv1(hidden)
+        hidden = self.act(hidden)
+        hidden = self.pwconv2(hidden)
